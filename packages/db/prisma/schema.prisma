generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id         String      @id @default(uuid())
  nickname   String
  token      String      @unique
  createdAt  DateTime    @default(now())
  characters Character[]
}

model Character {
  id           String   @id @default(uuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  class        String   @default("wizard")
  level        Int      @default(1)
  xp           Int      @default(0)
  hp           Int      @default(100)
  maxHp        Int      @default(100)
  mp           Int      @default(50)
  maxMp        Int      @default(50)
  defense      Float    @default(0)
  speed        Float    @default(5.5)
  attack       Float    @default(10)
  dexterity    Float    @default(10)
  equippedWeapon String? @default("staff_energy")
  equippedArmor  String? @default("robe_apprentice")
  inventory    String   @default("[]")
  currentWorld String   @default("nexus")
  x            Float    @default(20.0)
  y            Float    @default(20.0)
  isAlive      Boolean  @default(true)
  deathReason  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


{
  "name": "mmoexile",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @mmoexile/instance-server --filter @mmoexile/client dev",
    "dev:server": "pnpm --filter @mmoexile/instance-server dev",
    "dev:client": "pnpm --filter @mmoexile/client dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:push": "pnpm --filter @mmoexile/db db:push",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^18.4.0",
    "typescript": "^5.8.0"
  }
}

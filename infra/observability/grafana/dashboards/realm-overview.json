    {
      "type": "timeseries",
      "title": "Handoff duration p95: within vs. across regions",
      "description": "Ticket issue \u2192 admission for server-to-server handoffs, by the region left and the region entered. eu \u2192 us pays the distance to the central services on the US side.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (from_region, to_region, le) (rate(mmoexile_handoff_duration_seconds_bucket{kind=\"zone_change\",to_region=~\"$region\"}[5m])))",
          "legendFormat": "{{from_region}} \u2192 {{to_region}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (to_region, le) (rate(mmoexile_handoff_duration_seconds_bucket{kind=\"login\",to_region=~\"$region\"}[5m])))",
          "legendFormat": "login \u2192 {{to_region}}"
        }
      ],
      "id": 19
    },
    {
      "type": "timeseries",
      "title": "Allocation failures by reason",
      "description": "Refused allocations per reason and the player's home region (region_unavailable: no capacity in that region, no spill-over).",

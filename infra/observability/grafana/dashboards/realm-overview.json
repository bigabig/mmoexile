          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (server) (mmoexile_event_loop_utilization{region=~\"$region\"})",
          "legendFormat": "{{server}}"
        }
      ],
      "id": 14
    },
    {
      "type": "timeseries",

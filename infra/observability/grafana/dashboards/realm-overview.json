          "legendFormat": "{{reason}} ({{region}})"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (result, region) (rate(mmoexile_play_requests_total{result!=\"ok\",region=~\"$region\"}[1m]))",
          "legendFormat": "login {{result}} ({{region}})"

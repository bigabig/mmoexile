# Copy to .env to override defaults. Without it, everything uses the
# docker-compose database below (pnpm db:up).
DATABASE_URL=postgresql://mmoexile:mmoexile@localhost:5432/mmoexile

# Host ports for the compose containers
MMOEXILE_POSTGRES_PORT=5432
MMOEXILE_REDIS_PORT=6379

# Redis for leases, tickets and messaging
REDIS_URL=redis://localhost:6379

# Social service (parties), used by instance servers
SOCIAL_URL=http://localhost:3002

# Orchestrator (allocation, tickets, fleet), used by account-api and instance servers
ORCHESTRATOR_URL=http://localhost:3003

# Ticket keys (Ed25519). Development has built-in defaults; generate real ones
# with `pnpm --filter @mmoexile/auth keygen`. The private key goes to the
# orchestrator only, the public key to instance servers.
# TICKET_PRIVATE_KEY=
# TICKET_PUBLIC_KEY=

# Run tests against an existing database instead of a throwaway container
# TEST_DATABASE_URL=postgresql://mmoexile:mmoexile@localhost:5432/mmoexile_test
